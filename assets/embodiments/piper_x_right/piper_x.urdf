<?xml version="1.0" encoding="utf-8"?>
<!--
  PiPER-X simulation model for RoboTwin.
  Arm and gripper geometry/inertial data are derived from AgileX Robotics'
  agx_arm_urdf repository. Package URIs and Xacro mimic joints are flattened so
  that SAPIEN and cuRobo can load the same standalone file. RoboTwin drives the
  two finger joints explicitly from the virtual `gripper` joint.
-->
<robot name="piper_x">
  <link name="base_link">
    <inertial>
      <origin xyz="-0.00473641164191482 0.0000256829134630247 0.041451518036016" rpy="0 0 0"/>
      <mass value="1.02"/>
      <inertia ixx="0.00267433" ixy="-0.00000073" ixz="-0.00017389" iyy="0.00282612" iyz="0.0000004" izz="0.00089624"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../piper_x/meshes/dae/base_link.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../piper_x/meshes/base_link.stl"/></geometry>
    </collision>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0.00053 -0.00039 -0.00315" rpy="0 0 0"/>
      <mass value="0.71"/>
      <inertia ixx="0.00050027" ixy="0.00000078" ixz="0.00000626" iyy="0.00040879" iyz="0.00000462" izz="0.00045802"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/dae/link1.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/link1.stl"/></geometry></collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.123" rpy="0 0 3.1415926"/>
    <parent link="base_link"/><child link="link1"/><axis xyz="0 0 1"/>
    <limit lower="-2.6179938" upper="2.6179938" effort="100" velocity="5"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="0.21856 -0.00859 0.00227" rpy="0 0 0"/>
      <mass value="1.16"/>
      <inertia ixx="0.00111915" ixy="0.00182916" ixz="0.00019233" iyy="0.06763251" iyz="0.00000767" izz="0.067559"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/dae/link2.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/link2.stl"/></geometry></collision>
  </link>
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5707963 -3.005806 -3.1415926"/>
    <parent link="link1"/><child link="link2"/><axis xyz="0 0 1"/>
    <limit lower="0" upper="3.1415926" effort="100" velocity="5"/>
  </joint>

  <link name="link3">
    <inertial>
      <origin xyz="0.2014 -0.00418 -0.00141" rpy="0 0 0"/>
      <mass value="0.67"/>
      <inertia ixx="0.00033471" ixy="0.00026891" ixz="0.00013918" iyy="0.03360411" iyz="0.00000052" izz="0.03356941"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/dae/link3.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/link3.stl"/></geometry></collision>
  </link>
  <joint name="joint3" type="revolute">
    <origin xyz="0.28503 0 0" rpy="0 0 2.8380798"/>
    <parent link="link2"/><child link="link3"/><axis xyz="0 0 1"/>
    <limit lower="-2.9670597" upper="0" effort="100" velocity="5"/>
  </joint>

  <link name="link4">
    <inertial>
      <origin xyz="0.059 -0.05831 0.002" rpy="0 0 0"/>
      <mass value="0.39"/>
      <inertia ixx="0.00120173" ixy="0.00138165" ixz="0.00001187" iyy="0.00209324" iyz="0.00000217" izz="0.00307814"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/dae/link4.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/link4.stl"/></geometry></collision>
  </link>
  <joint name="joint4" type="revolute">
    <origin xyz="0.27364 0 0" rpy="0 0 0.0806342"/>
    <parent link="link3"/><child link="link4"/><axis xyz="0 0 1"/>
    <limit lower="-1.553343" upper="1.553343" effort="100" velocity="5"/>
  </joint>

  <link name="link5">
    <inertial>
      <origin xyz="0.00005 -0.01282 -0.00429" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.00022660" ixy="0.00000019" ixz="0.00000005" iyy="0.00017740" iyz="0.00000085" izz="0.00019425"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/dae/link5.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/link5.stl"/></geometry></collision>
  </link>
  <joint name="joint5" type="revolute">
    <origin xyz="0.07466 0 0" rpy="-1.5707963 1.5707963 0"/>
    <parent link="link4"/><child link="link5"/><axis xyz="0 0 1"/>
    <limit lower="-1.553343" upper="1.553343" effort="100" velocity="5"/>
  </joint>

  <link name="link6">
    <inertial>
      <origin xyz="0 0 -0.0035" rpy="0 0 0"/>
      <mass value="0.007"/>
      <inertia ixx="0.00152112" ixy="0.00000202" ixz="0.00000261" iyy="0.00138626" iyz="0.00000002" izz="0.00031152"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/dae/link6.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/link6.stl"/></geometry></collision>
  </link>
  <joint name="joint6" type="revolute">
    <origin xyz="0 -0.035 0" rpy="1.5707963 0 0"/>
    <parent link="link5"/><child link="link6"/><axis xyz="0 0 1"/>
    <limit lower="-2.0943951" upper="2.0943951" effort="100" velocity="5"/>
  </joint>

  <link name="flange_link">
    <inertial>
      <origin xyz="0.001151691 0.000782428 0.004798051" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.000009935389" ixy="0" ixz="0" iyy="0.000010508003" iyz="0" izz="0.000019652873"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/dae/flange.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/flange.stl"/></geometry></collision>
  </link>
  <joint name="flange_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/><parent link="link6"/><child link="flange_link"/>
  </joint>

  <link name="gripper_base">
    <inertial>
      <origin xyz="-0.000183807162235591 0.0000805033155577911 0.0321436689908876" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00092934" ixy="0.00000034" ixz="-0.00000738" iyy="0.00071447" iyz="0.00000005" izz="0.00039442"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/dae/gripper_base.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/gripper_base.stl"/></geometry></collision>
  </link>
  <joint name="gripper_base_joint" type="fixed">
    <origin xyz="0 0 0.0045" rpy="0 0 1.5707963"/><parent link="flange_link"/><child link="gripper_base"/>
  </joint>

  <!-- Virtual master joint retained to match the real PiPER-X command interface. -->
  <link name="gripper_link"/>
  <joint name="gripper" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/><parent link="gripper_base"/><child link="gripper_link"/>
    <axis xyz="0 0 1"/><limit lower="0" upper="0.1" effort="10" velocity="3"/>
  </joint>

  <link name="gripper_link1">
    <inertial>
      <origin xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025" rpy="0 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/dae/gripper_link1.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/gripper_link1.stl"/></geometry></collision>
  </link>
  <joint name="gripper_joint1" type="prismatic">
    <origin xyz="0 0 0.138" rpy="1.5707963 0 0"/><parent link="gripper_base"/><child link="gripper_link1"/>
    <axis xyz="0 0 1"/><limit lower="0" upper="0.05" effort="10" velocity="3"/>
  </joint>

  <link name="gripper_link2">
    <inertial>
      <origin xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025" rpy="0 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
    </inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/dae/gripper_link2.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../piper_x/meshes/gripper_link2.stl"/></geometry></collision>
  </link>
  <joint name="gripper_joint2" type="prismatic">
    <origin xyz="0 0 0.138" rpy="1.5707963 0 -3.1415926"/><parent link="gripper_base"/><child link="gripper_link2"/>
    <axis xyz="0 0 -1"/><limit lower="-0.05" upper="0" effort="10" velocity="3"/>
  </joint>

  <!-- Camera frame uses SAPIEN's +X forward, +Y left, +Z up convention. -->
  <link name="camera"/>
  <joint name="camera_joint" type="fixed">
    <!--
      2026-09-08 workcell calibration, right wrist.  The exported
      T_right_ee_camera uses OpenCV optical axes and is converted here to
      SAPIEN camera axes (+X forward, +Y left, +Z up).
    -->
    <origin xyz="-0.042692071592 -0.069500167581 0.033531161075"
            rpy="0.063599383360 -1.213595773709 1.543325146309"/>
    <parent link="link6"/><child link="camera"/>
  </joint>
</robot>
